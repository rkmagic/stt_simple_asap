OPENAI_API_KEY=your_openai_api_key_here
PORT=3000

# Optional: when set, POST /api/transcribe requires:
#   Authorization: Bearer <same value>
# Leave unset for local-only use without a bearer token.
# API_KEY=

# Optional: for npm run verify / Docker build (minimum days since publish on npm)
# MIN_RELEASE_AGE_DAYS=3
# SKIP_MIN_RELEASE_AGE=1
